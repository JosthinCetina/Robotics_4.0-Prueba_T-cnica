        <visual name="v1"><geometry><box><size>0.2 10 1</size></box></geometry></visual>
      </link>
      <link name="wall_2">
        <pose>-5 0 0.5 0 0 0</pose>
        <collision name="c2"><geometry><box><size>0.2 10 1</size></box></geometry></collision>
        <visual name="v2"><geometry><box><size>0.2 10 1</size></box></geometry></visual>
      </link>
      <link name="wall_3">
        <pose>0 5 0.5 0 0 1.5708</pose>
        <collision name="c3"><geometry><box><size>0.2 10 1</size></box></geometry></collision>
        <visual name="v3"><geometry><box><size>0.2 10 1</size></box></geometry></visual>
      </link>
      <link name="wall_4">
        <pose>0 -5 0.5 0 0 1.5708</pose>
        <collision name="c4"><geometry><box><size>0.2 10 1</size></box></geometry></collision>
        <visual name="v4"><geometry><box><size>0.2 10 1</size></box></geometry></visual>
      </link>
    </model>
  </world>
</sdf>
